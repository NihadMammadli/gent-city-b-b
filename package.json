{
  "name": "gent-city-bb",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Gent City B&B, a boutique bed and breakfast in the historic centre of Ghent.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:check && next build",
    "start": "serve out -l 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "tsx scripts/content-check.ts",
    "images": "node scripts/images.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
